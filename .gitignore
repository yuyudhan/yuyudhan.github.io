# .gitignore

#################
# Jekyll specific
#################

# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata

# Temporary files
.sass-cache/
.jekyll-cache/
.jekyll-metadata

#################
# Dependencies
#################

# Ruby dependencies
vendor/
.bundle/
Gemfile.lock

# Node.js dependencies (if using npm/yarn for assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

#################
# IDE & Editors
#################

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Atom
.atom/

#################
# Operating System
#################

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB/
.AppleDesktop/
Network Trash Folder/
Temporary Items/
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

#################
# Development
#################

# Log files
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# ESLint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

#################
# Build & Deploy
#################

# Build directories
build/
dist/
out/

# Docker
.dockerignore
docker-compose*.yml

# Deployment
.deploy*/

#################
# Backup & Temp
#################

# Backup files
*.bak
*.backup
*.old
*.orig
*.tmp

# Temporary directories
tmp/
temp/

#################
# Security
#################

# API keys and sensitive data
secrets.yml
.secrets
*.key
*.pem
*.p12
*.p8
*.cer
*.crt
*.der

# Authentication tokens
.netrc

#################
# Misc
#################

# Thumbnails
*.jpg:Zone.Identifier
*.png:Zone.Identifier
*.gif:Zone.Identifier

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Executables
*.exe
*.out
*.app

# Drafts (uncomment if you want to exclude draft posts)
# _drafts/